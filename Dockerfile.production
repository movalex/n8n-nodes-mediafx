# Multi-stage Dockerfile for production-ready testing
FROM node:18-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Set working directory
WORKDIR /app

# Copy source files
COPY package*.json ./
COPY tsconfig.json ./
COPY gulpfile.js ./
COPY nodes/ ./nodes/
COPY fonts/ ./fonts/

# Install dependencies and build
RUN npm ci
RUN npm run build

# Production stage
FROM n8nio/n8n:latest

# Switch to root to install system packages
USER root

# Install FFmpeg and other media processing tools
RUN apk add --no-cache \
    ffmpeg \
    imagemagick \
    && rm -rf /var/cache/apk/*

# Switch back to node user  
USER node

# Create directories
RUN mkdir -p /home/node/.n8n/nodes

# Copy built package from builder stage
COPY --from=builder /app/dist/ /tmp/mediafx/dist/
COPY --from=builder /app/fonts/ /tmp/mediafx/fonts/
COPY --from=builder /app/package.json /tmp/mediafx/

# Install the node package
WORKDIR /tmp/mediafx
RUN npm install --omit=dev

# Install the package globally for n8n
WORKDIR /home/node/.n8n/nodes
RUN npm init -y && npm install /tmp/mediafx

# Clean up
RUN rm -rf /tmp/mediafx

# Set working directory back to home
WORKDIR /home/node

# Expose port
EXPOSE 5678

# Start n8n
CMD ["n8n", "start"]
